# Ethereum Airways — environment template
# Copy to .env.local and fill in. Never commit real values.

# WalletConnect / 1001 EVM layer
NUXT_PUBLIC_EVM_WALLET_CONNECT_PROJECT_ID=
NUXT_PUBLIC_EVM_CHAINS_MAINNET_RPCS=
NUXT_PUBLIC_EVM_CHAINS_SEPOLIA_RPCS=
NUXT_PUBLIC_CHAIN_ID=

# Boarding pass + Vessel (chain-specific; Sepolia until mainnet launch)
NUXT_PUBLIC_BOARDING_PASS_ADDRESS=
NUXT_PUBLIC_VESSEL_ADDRESS=
NUXT_PUBLIC_VESSEL_CRAFT_ID=

# Convex
# Deployment: diligent-seahorse-531
# Cloud URL: https://diligent-seahorse-531.convex.cloud
# HTTP actions: https://diligent-seahorse-531.convex.site
NUXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Foundry / deployment (server-side only)
ETHEREUM_RPC_URL=
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
TREASURY_ADDRESS=
